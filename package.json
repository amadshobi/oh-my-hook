{
  "name": "oh-my-hook",
  "version": "0.1.0",
  "type": "module",
  "description": "Command Code-style workflow plugins for OpenCode: mode enforcement, read-before-write, security guardrails, session context, and verification reminders.",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "guard",
    "context",
    "reminder",
    "memory",
    "share"
  ],
  "keywords": [
    "opencode",
    "plugin",
    "guardrails",
    "hooks",
    "agent",
    "workflow",
    "ai"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "test:e2e": "node tests/e2e/read-guard.e2e.js && node tests/e2e/stale-write.hook.e2e.js",
    "test:all": "npm test && npm run test:e2e",
    "prepare": "git config core.hooksPath .githooks || true"
  }
}

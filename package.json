{
	"name": "@amadshobi/oh-my-hook",
	"version": "0.8.0",
	"type": "module",
	"description": "The ultimate power-tools, guardrails, and runtime enhancement suite for OpenCode coding agents.",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/amadshobi/oh-my-hook.git"
	},
	"bugs": {
		"url": "https://github.com/amadshobi/oh-my-hook/issues"
	},
	"homepage": "https://github.com/amadshobi/oh-my-hook#readme",
	"main": "index.js",
	"exports": {
		".": "./index.js",
		"./server": "./index.js",
		"./tui": "./tui/dist/tui.js"
	},
	"oc-plugin": [
		"server",
		"tui"
	],
	"files": [
		"index.js",
		"sandbox",
		"compress",
		"context",
		"reminder",
		"memory",
		"plans",
		"prompts",
		"gateway",
		"imgsee",
		"usage",
		"share",
		"schemas",
		"tui"
	],
	"keywords": [
		"opencode",
		"opencode-plugin",
		"ai-agent",
		"coding-agent",
		"agent-framework",
		"guardrails",
		"developer-tools",
		"workflow-automation",
		"context-management",
		"hooks"
	],
	"license": "MIT",
	"engines": {
		"node": ">=18.0.0"
	},
	"scripts": {
		"test": "node --test tests/*.test.js",
		"build:tui": "node tui/scripts/build.mjs",
		"test:e2e": "npm run test:e2e:hooks && npm run test:e2e:read-guard",
		"test:e2e:hooks": "node tests/e2e/stale-write.hook.e2e.js && node tests/e2e/read-guard-session.hook.e2e.js && node tests/e2e/mode-intent.hook.e2e.js && node tests/e2e/security.hook.e2e.js && node tests/e2e/plans-commands.hook.e2e.js && node tests/e2e/compress.hook.e2e.js && node tests/e2e/memory.hook.e2e.js",
		"test:e2e:read-guard": "node tests/e2e/read-guard.e2e.js",
		"test:e2e:stale-write": "node tests/e2e/stale-write.hook.e2e.js",
		"test:e2e:mode": "node tests/e2e/mode-intent.hook.e2e.js",
		"test:e2e:security": "node tests/e2e/security.hook.e2e.js",
		"test:e2e:plans": "node tests/e2e/plans-commands.hook.e2e.js",
		"test:e2e:compress": "node tests/e2e/compress.hook.e2e.js",
		"test:all": "npm test && npm run test:e2e:hooks",
		"verify": "bash scripts/verify-all.sh",
		"prepare": "git config core.hooksPath .githooks || true"
	}
}

#!/usr/bin/env bash
set -euo pipefail

# Check staged changes only (efficient, fast execution)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -v '^tests/' || true)

# 1. Full Secret Scanning on Staged Diff
if [ -n "$STAGED_FILES" ]; then
  STAGED_DIFF=$(git diff --cached --unified=0 -- $STAGED_FILES || true)
  if echo "$STAGED_DIFF" | grep -Eq 'ghp_[A-Za-z0-9_]{20,}|github_pat_[A-Za-z0-9_]{20,}|sk-[a-zA-Z0-9_-]{20,}|sk-ant-[a-zA-Z0-9_-]{20,}|AIza[0-9A-Za-z_-]{35}|AKIA[0-9A-Z]{16}|ASIA[0-9A-Z]{16}|-----BEGIN (RSA|EC|OPENSSH|PGP|PRIVATE) KEY-----|eyJ[a-zA-Z0-9_-]{10,}\.eyJ[a-zA-Z0-9_-]{10,}'; then
    echo "[pre-commit] Security Error: Sensitive API token, private key, or credential signature detected in staged diff!"
    exit 1
  fi
fi

# 2. TUI Build Sync Validation (only when tui/src/ is modified)
TUI_SRC_STAGED=$(git diff --cached --name-only -- tui/src/ || true)
if [ -n "$TUI_SRC_STAGED" ]; then
  npm run build:tui > /dev/null
  if ! git diff --quiet tui/dist/; then
    echo "[pre-commit] Error: tui/dist/ is out-of-sync with staged tui/src/ changes."
    echo "[pre-commit] Please run 'npm run build:tui' and stage tui/dist/tui.js before committing."
    exit 1
  fi
fi

# 3. JS Syntax Check on Staged Files (node --check)
JS_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(js|mjs)$' || true)
if [ -n "$JS_FILES" ]; then
  echo "$JS_FILES" | while IFS= read -r file; do
    if [ -f "$file" ]; then
      node --check "$file"
    fi
  done
fi

# 4. Fast Unit Tests
npm test > /dev/null

echo "[pre-commit] All staged checks passed."

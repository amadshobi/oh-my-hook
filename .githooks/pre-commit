#!/usr/bin/env bash
set -euo pipefail

echo "🔍 [pre-commit] Checking staged changes..."

# 1. Scan staged files for secret patterns (excluding test suites)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -v '^tests/' || true)
if [ -n "$STAGED_FILES" ]; then
  STAGED_DIFF=$(git diff --cached --unified=0 -- $STAGED_FILES || true)
  if echo "$STAGED_DIFF" | grep -Eq 'ghp_[A-Za-z0-9_]{20,}|AKIA[0-9A-Z]{16}|-----BEGIN (RSA|EC|OPENSSH|PGP) PRIVATE KEY-----'; then
    echo "❌ [pre-commit] Error: Sensitive token or private key detected in staged changes!"
    exit 1
  fi
fi

# 2. Native JS Syntax Check (node --check)
JS_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(js|mjs)$' || true)
if [ -n "$JS_FILES" ]; then
  echo "⚡ [pre-commit] Checking JS syntax..."
  for file in $JS_FILES; do
    if [ -f "$file" ]; then
      node --check "$file"
    fi
  done
fi

# 3. Fast Unit Tests
echo "🧪 [pre-commit] Running unit tests..."
npm test

echo "✅ [pre-commit] All checks passed."
